<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 前台服务保活：切后台后维持 SSH 会话与 Agent 任务运行 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ (API 34) 要求声明前台服务类型，dataSync 适用于网络长连接保活 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13+ (API 33) 运行时权限：系统通知（Agent 审批/提问/完成/失败 + 常驻通知） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 实时活动：允许系统把本应用的常驻通知提升为状态栏胶囊 / 灵动岛 / 超级岛
         （normal|appop，安装时授予；用户可在系统设置里逐应用关闭）。旧系统不认识这个权限，忽略即可。 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Agent 事件通知振动（O 以下设备由 NotificationCompat.setVibrate 控制，需显式声明权限） -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 保持 CPU 唤醒，防止 Doze 冻结导致 SSH keepalive 发不出去 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 应用内更新：允许本应用把下载好的 APK 交给系统安装器。Android 8+
         必须声明此权限，「安装未知应用」开关才会出现在系统设置里；没有它
         installUpdateApk 会失败（系统也不会列出本应用供授权）。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 应用内更新：判断当前网络是否计量（移动数据），计量网络下不自动下载
         安装包，避免静默消耗用户流量。isActiveNetworkMetered 需要此权限。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 扫一扫同步码：WebView 里 getUserMedia(VIDEO_CAPTURE) 需要相机权限。
         运行时授权由 wry 的 RustWebChromeClient.onPermissionRequest 代问，这里只声明。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 没有相机的设备（电视盒子、部分平板）也能装：扫码只是加入同步的一种方式，
         手动粘贴同步码始终可用，所以不设 required。 -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Android 11+ 包可见性：判断系统有没有「实时活动放行页」要先解析这个 Intent -->
    <queries>
        <intent>
            <action android:name="android.settings.APP_NOTIFICATION_PROMOTION_SETTINGS" />
        </intent>
    </queries>

    <application
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.marcel_ssh"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- 预见式返回：application 与 activity 两级都显式声明。部分厂商 ROM 只认 activity 级，
             只写 application 时应用收不到手势开始 / 进度，只收得到松手后的确认（调试页「返回手势诊断」可验证）。 -->
        <activity
            android:enableOnBackInvokedCallback="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:theme="@style/Theme.marcel_ssh.Splash"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 前台保活服务：SSH 会话/Agent 任务在后台持续运行 -->
        <service
            android:name=".MarcelForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false"
            android:stopWithTask="false" />

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
